<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/jstore_store_ripple_on_accent">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="@color/jstore_store_surface_disabled" />
                    <corners android:radius="@dimen/jstore_store_radius_pill" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/jstore_store_status_danger" />
                    <corners android:radius="@dimen/jstore_store_radius_pill" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
