<?xml version="1.0" encoding="utf-8"?>
<!--
  The dialog panel. Sits on top of the dimmed screen, so it uses the elevated
  card surface (not surface_variant) — fields inside it can then be
  surface_variant and still read as recessed.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/jstore_store_surface_card" />
    <corners android:radius="@dimen/jstore_store_radius_lg" />
    <stroke
        android:width="1dp"
        android:color="@color/jstore_store_surface_border" />
</shape>
