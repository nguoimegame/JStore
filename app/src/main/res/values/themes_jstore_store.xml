<resources>
    <!--
      The store screen shown inside JaecooApp. Plain AppCompat, as JaecooApp's own theme is:
      a Material theme would turn the Buttons into MaterialButtons, which ignore the
      android:background the layouts give them.
    -->
    <style name="jstore_store_Theme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/jstore_store_accent_primary</item>
        <item name="colorAccent">@color/jstore_store_accent_primary</item>
        <item name="android:windowBackground">@drawable/jstore_store_bg_app_gradient</item>
        <item name="android:textColorPrimary">@color/jstore_store_content_primary</item>
        <item name="android:textColorSecondary">@color/jstore_store_content_secondary</item>
        <item name="switchStyle">@style/jstore_store_Widget.JaecooApp.SwitchCompat</item>
    </style>
</resources>
