<?xml version="1.0" encoding="utf-8"?>
<!--
  The "Online store" tab. Google Play lives in jstore, a separate app; this card
  opens it, or installs and updates it from jstore's latest GitHub release.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panelJstore"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/jstore_store_content_margin_start"
        android:layout_marginTop="@dimen/jstore_store_space_md"
        android:layout_marginEnd="@dimen/jstore_store_content_margin_end"
        android:background="@drawable/jstore_store_bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/jstore_store_space_lg">

        <FrameLayout
            android:layout_width="@dimen/jstore_store_icon_tile"
            android:layout_height="@dimen/jstore_store_icon_tile"
            android:background="@drawable/jstore_store_bg_icon_tile_accent">

            <ImageView
                android:layout_width="@dimen/jstore_store_icon_md"
                android:layout_height="@dimen/jstore_store_icon_md"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/jstore_store_ic_nav_appstore"
                android:tint="@color/jstore_store_icon_active" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/jstore_store_space_lg"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvJstoreTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/jstore_store_content_primary"
                android:textSize="@dimen/jstore_store_text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvJstoreDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/jstore_store_space_xs"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/jstore_store_content_secondary"
                android:textSize="@dimen/jstore_store_text_body_sm" />

            <!-- Download progress while jstore itself is being installed. -->
            <ProgressBar
                android:id="@+id/pbJstoreInstall"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="@dimen/jstore_store_space_sm"
                android:max="100"
                android:progressTint="@color/jstore_store_accent_primary"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Shown when a newer jstore release is on GitHub. -->
        <Button
            android:id="@+id/btnJstoreUpdate"
            style="@style/jstore_store_Button.Warning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/jstore_store_space_lg"
            android:text="@string/jstore_store_jstore_update"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnJstore"
            style="@style/jstore_store_Button.Accent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/jstore_store_space_lg"
            android:minWidth="140dp" />
    </LinearLayout>
</LinearLayout>
