<?xml version="1.0" encoding="utf-8"?>
<!--
  One installed app on the app manager screen: update / open / uninstall buttons,
  then the switch that keeps it on the launcher. Checked means visible, so the
  switch reads the same way as the icon the driver is looking for.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/jstore_store_app_list_item_gap"
    android:layout_marginEnd="@dimen/jstore_store_app_list_item_gap"
    android:layout_marginBottom="@dimen/jstore_store_space_md"
    android:background="@drawable/jstore_store_bg_card"
    android:gravity="center_vertical"
    android:minHeight="@dimen/jstore_store_row_height"
    android:orientation="horizontal"
    android:padding="@dimen/jstore_store_space_lg">

    <ImageView
        android:id="@+id/appIcon"
        android:layout_width="@dimen/jstore_store_icon_tile"
        android:layout_height="@dimen/jstore_store_icon_tile"
        android:contentDescription="@string/jstore_store_app_icon_desc"
        android:scaleType="fitCenter"
        android:src="@drawable/jstore_store_ic_apps" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/jstore_store_space_lg"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Name, then the badges that say what is special about this app -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/appName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/jstore_store_content_primary"
                android:textSize="@dimen/jstore_store_text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/appUpdateBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/jstore_store_space_sm"
                android:background="@drawable/jstore_store_bg_pill_badge_amber"
                android:paddingStart="@dimen/jstore_store_space_sm"
                android:paddingTop="3dp"
                android:paddingEnd="@dimen/jstore_store_space_sm"
                android:paddingBottom="3dp"
                android:text="@string/jstore_store_update_available"
                android:textColor="@color/jstore_store_status_warning"
                android:textSize="@dimen/jstore_store_text_label"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/appHiddenBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/jstore_store_space_sm"
                android:background="@drawable/jstore_store_bg_pill_badge"
                android:paddingStart="@dimen/jstore_store_space_sm"
                android:paddingTop="3dp"
                android:paddingEnd="@dimen/jstore_store_space_sm"
                android:paddingBottom="3dp"
                android:text="@string/jstore_store_app_visibility_badge_hidden"
                android:textColor="@color/jstore_store_content_secondary"
                android:textSize="@dimen/jstore_store_text_label"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Installed version (→ new version · source), then the package -->
        <TextView
            android:id="@+id/appVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/jstore_store_space_xs"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/jstore_store_accent_primary"
            android:textSize="@dimen/jstore_store_text_caption" />

        <TextView
            android:id="@+id/appPackage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/jstore_store_space_xs"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/jstore_store_content_secondary"
            android:textSize="@dimen/jstore_store_text_caption" />

        <!-- Update progress, only while this app is downloading or installing -->
        <LinearLayout
            android:id="@+id/containerUpdateProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/jstore_store_space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pbUpdate"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/jstore_store_accent_primary" />

            <TextView
                android:id="@+id/tvUpdateProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/jstore_store_space_md"
                android:textColor="@color/jstore_store_accent_primary"
                android:textSize="@dimen/jstore_store_text_caption"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnUpdate"
        style="@style/jstore_store_Button.Warning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/jstore_store_space_lg"
        android:minWidth="120dp"
        android:text="@string/jstore_store_update_app"
        android:visibility="gone" />

    <!-- Open above Uninstall, same width, so the row stays narrow -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/jstore_store_space_md"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnOpen"
            style="@style/jstore_store_Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minWidth="100dp"
            android:text="@string/jstore_store_open_app" />

        <Button
            android:id="@+id/btnUninstall"
            style="@style/jstore_store_Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/jstore_store_space_sm"
            android:minWidth="100dp"
            android:text="@string/jstore_store_uninstall"
            android:textColor="@color/jstore_store_status_danger" />
    </LinearLayout>

    <!-- Divider between the one-off actions and the standing launcher setting -->
    <View
        android:layout_width="1dp"
        android:layout_height="@dimen/jstore_store_touch_min"
        android:layout_marginStart="@dimen/jstore_store_space_lg"
        android:background="@color/jstore_store_surface_divider" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/jstore_store_space_lg"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchVisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/jstore_store_switch_track_width"
            android:minHeight="@dimen/jstore_store_touch_min"
            android:thumb="@drawable/jstore_store_switch_thumb"
            app:switchMinWidth="@dimen/jstore_store_switch_track_width"
            app:track="@drawable/jstore_store_switch_track" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:text="@string/jstore_store_app_manager_switch_label"
            android:textColor="@color/jstore_store_content_secondary"
            android:textSize="@dimen/jstore_store_text_label" />
    </LinearLayout>
</LinearLayout>
