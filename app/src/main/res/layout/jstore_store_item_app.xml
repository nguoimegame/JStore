<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/jstore_store_app_list_item_gap"
    android:layout_marginEnd="@dimen/jstore_store_app_list_item_gap"
    android:layout_marginBottom="@dimen/jstore_store_space_md"
    android:background="@drawable/jstore_store_bg_card"
    android:gravity="center_vertical"
    android:minHeight="@dimen/jstore_store_row_height"
    android:orientation="horizontal"
    android:padding="@dimen/jstore_store_space_lg">

    <!-- App Icon Tile (No hardcoded tint so real colors/system icon show through) -->
    <ImageView
        android:id="@+id/appIcon"
        android:layout_width="@dimen/jstore_store_icon_tile"
        android:layout_height="@dimen/jstore_store_icon_tile"
        android:contentDescription="@string/jstore_store_app_icon_desc"
        android:scaleType="fitCenter"
        android:src="@drawable/jstore_store_ic_apps" />

    <!-- Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/jstore_store_space_lg"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Title & Status Badge Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/appName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/jstore_store_content_primary"
                android:textSize="@dimen/jstore_store_text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/appStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/jstore_store_space_sm"
                android:background="@drawable/jstore_store_bg_pill_badge_amber"
                android:paddingStart="@dimen/jstore_store_space_sm"
                android:paddingTop="3dp"
                android:paddingEnd="@dimen/jstore_store_space_sm"
                android:paddingBottom="3dp"
                android:text="@string/jstore_store_update_available"
                android:textColor="@color/jstore_store_status_warning"
                android:textSize="@dimen/jstore_store_text_label"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Category & Version Metadata -->
        <TextView
            android:id="@+id/appMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/jstore_store_space_xs"
            android:paddingBottom="@dimen/jstore_store_space_xs"
            android:textColor="@color/jstore_store_accent_primary"
            android:textSize="@dimen/jstore_store_text_caption" />

        <!-- Description -->
        <TextView
            android:id="@+id/appDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/jstore_store_content_secondary"
            android:textSize="@dimen/jstore_store_text_body_sm" />

        <!-- Download Progress Container (Visible only when downloading) -->
        <LinearLayout
            android:id="@+id/containerDownloadProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/jstore_store_space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pbItemDownload"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/jstore_store_accent_primary" />

            <TextView
                android:id="@+id/tvItemDownloadProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/jstore_store_space_md"
                android:textColor="@color/jstore_store_accent_primary"
                android:textSize="@dimen/jstore_store_text_caption"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Nút gỡ, chỉ hiện khi app đã có trên máy -->
    <Button
        android:id="@+id/uninstallButton"
        style="@style/jstore_store_Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/jstore_store_space_lg"
        android:minWidth="100dp"
        android:text="@string/jstore_store_uninstall"
        android:textColor="@color/jstore_store_status_danger"
        android:visibility="gone" />

    <!-- Action Button (Install / Update / Open / Downloading) -->
    <Button
        android:id="@+id/installButton"
        style="@style/jstore_store_Button.Accent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/jstore_store_space_lg"
        android:minWidth="140dp"
        android:text="@string/jstore_store_install" />
</LinearLayout>
