<?xml version="1.0" encoding="utf-8"?>
<!--
  Store switch: the Jaecoo server catalogue or the installed app manager.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/jstore_store_content_margin_start"
    android:layout_marginTop="@dimen/jstore_store_space_sm"
    android:layout_marginEnd="@dimen/jstore_store_content_margin_end"
    android:background="@drawable/jstore_store_bg_segment_track"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/segStoreLocal"
        android:layout_width="0dp"
        android:layout_height="@dimen/jstore_store_touch_min"
        android:layout_weight="1"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="@dimen/jstore_store_space_xs"
        android:paddingEnd="@dimen/jstore_store_space_xs"
        android:text="@string/jstore_store_app_store_tab_local"
        android:textColor="@color/jstore_store_content_secondary"
        android:textSize="@dimen/jstore_store_text_body_sm"
        android:autoSizeMaxTextSize="@dimen/jstore_store_text_body_sm"
        android:autoSizeMinTextSize="@dimen/jstore_store_tab_text_min"
        android:autoSizeTextType="uniform" />

    <TextView
        android:id="@+id/segStoreManage"
        android:layout_width="0dp"
        android:layout_height="@dimen/jstore_store_touch_min"
        android:layout_weight="1"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="@dimen/jstore_store_space_xs"
        android:paddingEnd="@dimen/jstore_store_space_xs"
        android:text="@string/jstore_store_nav_app_visibility"
        android:textColor="@color/jstore_store_content_secondary"
        android:textSize="@dimen/jstore_store_text_body_sm"
        android:autoSizeMaxTextSize="@dimen/jstore_store_text_body_sm"
        android:autoSizeMinTextSize="@dimen/jstore_store_tab_text_min"
        android:autoSizeTextType="uniform" />
</LinearLayout>
